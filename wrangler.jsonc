// DiveSlot en Cloudflare: un Worker sirve la app (Static Assets) y la API propia (/api/*, worker/index.js) sobre D1.
// Cloudflare compila con `npm run build` y publica con `npx wrangler deploy` en cada push a main.
// Mientras la app se compile sin VITE_BACKEND=cloudflare sigue usando Supabase y la API no recibe tráfico.
// Pasos para el cambio completo: docs/CLOUDFLARE-BACKEND.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diveslot",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    // La app (build de Vite). Para mostrar solo la página «En construcción», pon "./construccion".
    "directory": "./dist",
    "binding": "ASSETS",
    // Router por hash: cualquier ruta desconocida devuelve index.html…
    "not_found_handling": "single-page-application",
    // …salvo la API, que siempre va al Worker (también los enlaces de los emails, que se abren navegando)
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "diveslot", "database_id": "73f322b7-43c2-4234-a313-5f7e2e78c928" }
  ],
  // Ficheros privados (fotos de la bitácora y documentos de verificación). Activa R2 en el panel de Cloudflare,
  // crea los buckets «diveslot-dive-photos» y «diveslot-center-docs» y quita los comentarios:
  // "r2_buckets": [
  //   { "binding": "DIVE_PHOTOS", "bucket_name": "diveslot-dive-photos" },
  //   { "binding": "CENTER_DOCS", "bucket_name": "diveslot-center-docs" }
  // ],
  // Limpieza cada hora (sesiones caducadas, enlaces usados, pagos abandonados)
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true }
}
