// DivingSlot en Cloudflare: un Worker sirve la app (Static Assets) y la API propia (/api/*, worker/index.js) sobre D1.
// Cloudflare compila con `npm run build` y publica con `npx wrangler deploy` en cada push a main.
// Mientras .env.production diga VITE_BACKEND=supabase, la app usa Supabase y la API solo recibe visitas y avisos.
// Pasos para el cambio completo: docs/CAMBIO-A-CLOUDFLARE.md (único secreto obligatorio en el panel: GOOGLE_CLIENT_SECRET;
// AUTH_SECRET se genera solo y los avisos de Supabase llegan sin clave; qué falta: /api/health?check=1)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diveslot",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    // La app (build de Vite). Para mostrar solo la página «En construcción», pon "./construccion".
    "directory": "./dist",
    "binding": "ASSETS",
    // Router por hash: cualquier ruta desconocida devuelve index.html…
    "not_found_handling": "single-page-application",
    // …salvo la API, que siempre va al Worker (también los enlaces de los emails, que se abren navegando), y /r/<centro> (enlace de reservas del centro)
    "run_worker_first": ["/api/*", "/google3f09e05f2c350262.html", "/r/*", "/w/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "diveslot", "database_id": "73f322b7-43c2-4234-a313-5f7e2e78c928" }
  ],
  // Ficheros privados (fotos de la bitácora y documentos de verificación). R2 activado el 3 nov 2026; buckets en
  // Asia-Pacífico (APAC) para que carguen rápido en Filipinas.
  "r2_buckets": [
    { "binding": "DIVE_PHOTOS", "bucket_name": "divingslot-photos" },
    { "binding": "CENTER_DOCS", "bucket_name": "divingslot-docs" },
    // Copias de seguridad semanales de D1 (worker/backup.js, lunes 3:41 en Manila; se guardan 12 semanas)
    { "binding": "BACKUPS", "bucket_name": "divingslot-backups" }
  ],
  // Valores públicos (los secretos van en el panel: GOOGLE_CLIENT_SECRET y, si se usa, SMTP_*/RESEND_API_KEY)
  "vars": {
    "GOOGLE_CLIENT_ID": "607421255103-95p23bfnoe8v6beaehct5n41dbeahijl.apps.googleusercontent.com",
    // A quién llegan los avisos al administrador (altas, reservas, centros por validar) y el resumen diario
    "NOTIFY_TO": "divingslot@gmail.com"
    // Anti-bots al entrar y crear cuenta (Cloudflare Turnstile): añade aquí "TURNSTILE_SITE_KEY": "<clave del sitio>"
    // y en el panel del Worker el secreto TURNSTILE_SECRET. Con las dos, se activa solo (worker/auth.js, src/lib/Captcha.jsx).
  },
  // Emails sin claves con Cloudflare Email Service (Workers Paid contratado el 3 nov 2026). Envía desde
  // EMAIL_FROM o no-reply@divingslot.com: divingslot.com tiene que estar dado de alta en Email Service → Email Sending.
  "send_email": [{ "name": "EMAIL" }],
  // Limpieza cada hora (sesiones caducadas, enlaces usados, pagos abandonados, cierre de la importación), lista de espera
  // cada 10 min y copia de seguridad de D1 en R2 los domingos a las 19:41 UTC (BACKUP_CRON en worker/backup.js)
  "triggers": { "crons": ["17 * * * *", "*/10 * * * *", "41 19 * * 0"] },
  "observability": { "enabled": true }
}
